# Provider (L1 — deployment secrets & endpoint)
# Base URL of an Anthropic-compatible endpoint. No trailing "/v1/messages".
PROVIDER_BASE_URL=https://apiproxy.paigod.work
# Provider API key.
PROVIDER_API_KEY=LeRUDJK0LelugwyHf4aPsGdFRxQJdft4EmbcajmCm9s8S8Du
# Auth style: "bearer" for OpenRouter / DeepSeek / Kimi / most vendors;
# "x-api-key" for Anthropic official API.
PROVIDER_AUTH_STYLE=bearer

# Gateway (L1 — deployment)
# Port to listen on (default 3000).
MOM_PORT=3000
# SQLite database file path for traces / metrics_cache (default ./mom.db).
MOM_DB_PATH=mom.db
# Path to the MoM business-config file (default ./data/mom.config.json).
MOM_CONFIG_PATH=data/mom.config.json
